{
  "name": "mampf",
  "version": "1.0.0",
  "description": "Wochen-Essensplaner - Mampf",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc && node -e \"const fs=require('fs');const p=require('path');const s='src/client',d='dist/client';if(fs.existsSync(d))fs.rmSync(d,{recursive:true});fs.cpSync(s,d,{recursive:true});console.log('Client files copied.');\"",
    "start": "node --env-file=.env dist/server/index.js",
    "dev": "tsc && node --env-file=.env dist/server/index.js",
    "migrate": "node dist/server/migrate.js"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "express-session": "^1.18.0",
    "connect-sqlite3": "^0.9.15"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  }
}