# Mampf – Wochen-Essensplaner
# Kopiere diese Datei nach .env und passe die Werte an.
# APP_USERNAME, APP_PASSWORD und SESSION_SECRET sind Pflicht – ohne sie startet der Server nicht.

# Benutzername für die Anmeldung
APP_USERNAME=admin

# Passwort (Klartext)
APP_PASSWORD=dein-passwort

# Geheimer Schlüssel für die Session-Signatur, z.B.: openssl rand -hex 32
SESSION_SECRET=ein-langer-zufaelliger-string

# Port für den Webserver (Standard: 3000)
PORT=3000

# Pfad zur SQLite-Datenbank (in Docker: /app/data/meals.sqlite)
DATABASE_PATH=./data/meals.sqlite

# Session-Cookie nur über HTTPS senden. Bei Betrieb hinter HTTPS auf "true" setzen.
COOKIE_SECURE=false

# Optional: Express "trust proxy" (z.B. 1 hinter genau einem Reverse Proxy).
# Nötig, damit das Login-Limit die echte Client-IP sieht. Leer lassen, wenn kein Proxy davorsteht.
TRUST_PROXY=
