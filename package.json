{
  "name": "mampf",
  "version": "1.0.0",
  "description": "Mampf – Wochen-Essensplaner mit Einkaufsliste",
  "main": "dist/server/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-client.js",
    "start": "node --env-file=.env dist/server/index.js",
    "start:prod": "node dist/server/index.js",
    "dev": "npm run build && node --env-file=.env --watch-path=dist dist/server/index.js",
    "migrate": "node --env-file=.env dist/server/migrate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "tsc -p tsconfig.json --outDir dist-test && node scripts/run-tests.js dist-test && node --test src/client/js/*.test.mjs src/client/anna/*.test.mjs"
  },
  "dependencies": {
    "better-sqlite3": "^11.7.0",
    "express": "^4.21.0",
    "express-session": "^1.18.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.7.0",
    "typescript": "^5.6.0"
  },
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20"
  }
}
